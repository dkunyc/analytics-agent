# Names only. Do not commit a real .env. Do not paste keys, tokens, or private key material.
# The headless ask command reads these from the process environment. It does not read this file.

# OpenRouter. Requests go to https://openrouter.ai/api/v1.
# OPENROUTER_KEY is the LibreChat variable name. Do not set OPENROUTER_API_KEY:
# LibreChat documents that name as also rerouting its built-in OpenAI endpoint.
# This repo's client does not read OPENROUTER_API_KEY.
# Leave OPENROUTER_KEY unset, or set AGENT_PROVIDER=offline, for the scripted provider.

# OPENROUTER_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=
# AGENT_PROVIDER=
# AGENT_TRACE_PATH=

# Langfuse. All three are required for the OTLP export. Otherwise the trace stays in traces/ask.jsonl.
# LANGFUSE_BASE_URL is the origin, with no path.

# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# Reserved for LibreChat. The ask command does not read these.

# LIBRECHAT_CODE_BASEURL=
# OTEL_TRACING_ENABLED=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# RUM_ENABLED=
